# ==========================================
# CONFIGURACIÓN TELEGRAM NOTIFIER
# ==========================================
# Obtén tu token con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Obtén tu Chat ID con @userinfobot en Telegram (o el ID del grupo/canal con '-')
TELEGRAM_CHAT_ID=123456789

# ==========================================
# MODO DE OPERACIÓN
# ==========================================
# MODO: PAPER (Simulación en vivo con datos reales de mercado) | LIVE (Real con API Keys)
TRADING_MODE=PAPER

# ==========================================
# PARÁMETROS DEL PLAN DE CAPITAL (DCA & HWM)
# ==========================================
INITIAL_CAPITAL=100.0
WEEKLY_DEPOSIT=20.0
MAX_DEPOSIT_TOTAL=1000.0
RISK_PCT_HWM=0.02

# ==========================================
# LISTA DE ACTIVOS A OPERAR (Separados por coma)
# ==========================================
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# ==========================================
# CONFIGURACIÓN DE RED Y LOGGING
# ==========================================
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL_HOURS=24
POLLING_INTERVAL_SECONDS=15
